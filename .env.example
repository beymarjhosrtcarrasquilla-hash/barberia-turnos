# Copie a .env (NUNCA lo suba al repositorio; .env esta en .gitignore).
# PIN del barbero: se guarda solo como hash SHA-256 con sal, nunca en texto plano.
# Genere los valores con:  node scripts/generar-pin-hash.mjs <PIN de 4-8 digitos>
# Luego exponga BARBERIA_CONFIG = { pinSalt, pinHash } en un script propio (no versionado)
# antes de cargar js/barbero.js. Si no se define, el barbero configura su PIN en el primer uso.
BARBERO_PIN_SALT=
BARBERO_PIN_HASH=

# Supabase (opcional). Use SOLO la clave anon/publica; jamas la service_role en el cliente.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=